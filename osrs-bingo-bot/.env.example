# Copy this file to .env and fill in your values. Never commit the real .env file.

# From the Discord Developer Portal -> your application -> Bot -> Token
DISCORD_TOKEN=

# Optional: right-click your server icon -> Copy Server ID.
# Setting this makes slash commands sync instantly to that one server, which
# is much faster than waiting for a global sync (~1 hour) while developing.
GUILD_ID=

# --- Review channel & mod role: NOT set here anymore ---
# Use /setreviewchannel and /setmodrole in Discord instead, once the bot is
# running. They're stored in bingo.db and take effect immediately, no
# restart needed. (REVIEW_CHANNEL_ID / MOD_ROLE_NAME below are legacy --
# only used to auto-seed the database once, on a very first run, if it's
# otherwise empty. Once you've used the commands, these are never read again.)
REVIEW_CHANNEL_ID=
MOD_ROLE_NAME=Bingo Mod

# --- Stale submission nudge (optional -- sensible defaults if left blank) ---
# How many minutes a submission can sit pending before the bot pings the mod
# role about it in the review channel. Each submission is only nudged once.
STALE_MINUTES=30

# How often (in minutes) the bot checks for stale submissions. Kept shorter
# than STALE_MINUTES so a 30-minute threshold gets caught promptly rather
# than up to a full check-cycle late.
STALE_CHECK_MINUTES=10

# --- Event end date (optional -- /timeleft says "not configured" if blank) ---
# When the competition ends. Accepts YYYY-MM-DD (assumed midnight UTC) or a
# full ISO timestamp, e.g. 2026-08-15T23:59:59+00:00
EVENT_END_DATE=

# --- Google Sheets sync (optional -- leave blank to skip syncing approvals) ---
# Path to the service account JSON key file (see README for setup steps).
GOOGLE_SERVICE_ACCOUNT_FILE=

# The exact tab name at the bottom of EVERY team's sheet, e.g. Sheet4
# (assumes all teams' sheets use the same tab name -- ask if that's not true)
GOOGLE_WORKSHEET_NAME=

# Individual team channels/sheet IDs are NOT set here -- use /addteam and
# /setteamsheet in Discord instead. See the "Set up teams" section in
# README.md.
